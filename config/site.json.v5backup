  "faq": [
    {
      "q": "How much does the CAT 259B3 cost to rent?",
      "a": "$249.99 per day, $1,049.93 per week, or $2,999.70 per month. Pricing is final after we confirm dates and delivery. You can request a booking right from this site."
    },
    {
      "q": "How does delivery work?",
      "a": "Free pickup at our King Township location. Free delivery within King Township. $99 flat delivery fee for the Greater Toronto Area. For other locations in Southern Ontario, call us for a quote."
    },
    {
      "q": "Do you deliver to Aurora, Newmarket, or Richmond Hill?",
      "a": "Yes — these are all part of our GTA flat-rate delivery zone. We serve the full north GTA halo including Aurora, Newmarket, Richmond Hill, Vaughan, north Toronto, and Bradford."
    },
    {
      "q": "How many days can I rent for?",
      "a": "Anywhere from a single day to multi-week or multi-month rentals. Rates are tiered: daily for short rentals, weekly when you cross 7 days, monthly when you cross 30 days."
    },
    {
      "q": "Does the rental come with an operator?",
      "a": "No — the renter operates. We recommend the operator be experienced on full-size compact track loaders; if you need a trained operator, let us know and we can refer one."
    },
    {
      "q": "What attachments are included?",
      "a": "The CAT 259B3 comes with a standard bucket. Forks are available on request — mention what you need when you book or call."
    },
    {
      "q": "How do I book?",
      "a": "Use the booking form on this site to pick your dates, delivery option, and contact details. We confirm dates and delivery within a few hours during business hours. You can also call us directly."
    }
  ],
  "ctas": {
    "primary": "Call to book",
    "secondary": "Email for a quote",
    "formSubmit": "Send request"
  }
}
